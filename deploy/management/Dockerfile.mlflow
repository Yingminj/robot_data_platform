FROM python:3.11-slim

ARG MLFLOW_VERSION=3.1.1

RUN groupadd --system robotdata \
    && useradd --system --gid robotdata --no-create-home --shell /usr/sbin/nologin mlflow \
    && pip install --no-cache-dir "mlflow==${MLFLOW_VERSION}" "psycopg[binary]>=3.2,<4"

USER mlflow:robotdata
WORKDIR /opt/mlflow
