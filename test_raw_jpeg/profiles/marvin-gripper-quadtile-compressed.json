{
  "name": "marvin-gripper-quadtile-compressed",
  "robot_type": "marvin",
  "_comment": [
    "Generated by test_raw_jpeg for the raw-vs-JPEG comparison. Identical to",
    "marvin-gripper-quadtile.json except that the cameras read the CompressedImage",
    "mosaic topic, which is what the production RealSense node publishes and what",
    "test_raw_jpeg/scripts/02_build_jpeg80_bag.py writes."
  ],
  "arm": {
    "joint_states_topic": "/joint_states",
    "joint_names": [
      "Joint1_L",
      "Joint2_L",
      "Joint3_L",
      "Joint4_L",
      "Joint5_L",
      "Joint6_L",
      "Joint7_L",
      "Joint1_R",
      "Joint2_R",
      "Joint3_R",
      "Joint4_R",
      "Joint5_R",
      "Joint6_R",
      "Joint7_R"
    ],
    "command_topics": [
      "/control/joint_cmd_A",
      "/control/joint_cmd_B"
    ],
    "command_dim": 7
  },
  "end_effectors": [
    {
      "name": "L",
      "kind": "gripper",
      "dim": 1,
      "command_topic": "/control/gripperValueL",
      "command_kind": "float32",
      "state_topic": null
    },
    {
      "name": "R",
      "kind": "gripper",
      "dim": 1,
      "command_topic": "/control/gripperValueR",
      "command_kind": "float32",
      "state_topic": null
    }
  ],
  "cameras": {
    "top": "/quad_tile/compressed",
    "wrist_L": "/quad_tile/compressed",
    "wrist_R": "/quad_tile/compressed"
  },
  "camera_tiles": {
    "top": {
      "left": 0.0,
      "top": 0.0,
      "right": 1.0,
      "bottom": 0.6666666666666666,
      "width": 640,
      "height": 480
    },
    "wrist_L": {
      "left": 0.0,
      "top": 0.6666666666666666,
      "right": 0.5,
      "bottom": 1.0,
      "width": 640,
      "height": 480
    },
    "wrist_R": {
      "left": 0.5,
      "top": 0.6666666666666666,
      "right": 1.0,
      "bottom": 1.0,
      "width": 640,
      "height": 480
    }
  },
  "depths": {},
  "anchor_camera": "top",
  "message_definitions": {
    "marvin_msgs/msg/Jointcmd": "std_msgs/Header header\nfloat64[7] positions\n",
    "marvin_msgs/msg/JointcmdArm": "std_msgs/Header header\nfloat64[7] positions\n"
  }
}
