LELAB_CLUSTER_ENABLED=1
# Format: <Slurm NodeName>=<SSH target>. The SSH user does not have to match
# the Slurm node name. mgmt01 is detected as local; gpu01/gpu02/gpu03 log in as
# the existing administrator account "snorlax" for read-only nvidia-smi probes.
LELAB_CLUSTER_NODES=mgmt01=192.168.100.202,gpu01=snorlax@192.168.100.215,gpu02=yang@192.168.100.216,gpu03=snorlax@192.168.100.217
LELAB_SSH_CONNECT_TIMEOUT=3
LELAB_SSH_IDENTITY_FILE=/etc/robot-platform/lelab_ssh_key

LELAB_NAS_DATASETS_ROOT=/mnt/robot_platform/datasets
LELAB_OUTPUT_ROOT=/mnt/robot_platform/jobs
LELAB_MODEL_TEMPLATES=/etc/robot-platform/model-templates.json

# LeRobot and Hugging Face cache. Keep this local on the management host.
HF_HOME=/var/lib/robot-platform/huggingface

# Cache root for Slurm training jobs (torch hub backbone weights, HF, wandb).
# Slurm points HOME at robot-train's home, which does not exist on every
# worker, so a job that caches under ~ fails there. This path must exist and be
# writable by robot-train on EVERY node; the same local path on each node is
# fine, it does not have to be shared storage. Defaults to HF_HOME when unset.
LELAB_JOB_CACHE_ROOT=/var/lib/robot-platform/cache

# Node-local dataset staging. Unset (the default) trains straight from the NAS,
# re-reading every video file over NFS each epoch. Set this to a node-local path
# and each job rsyncs its dataset there once and trains from the copy; it must
# exist and be writable by robot-train on EVERY node, and is the DATASET_CACHE_ROOT
# that 10-install-management.sh and 20-install-gpu-node.sh already create.
#
# The copy is deliberately NOT deleted when the job ends: a sweep run and every
# resume would re-fetch it, and a job that is SIGKILLed (cgroup OOM, scancel past
# KillWait, node failure) could not run a cleanup step anyway. Instead each job
# sweeps the cache before staging, evicting least-recently-used datasets -- never
# one another job is reading -- until the incoming dataset fits with MIN_FREE_GB
# left on the filesystem. A cache too small to hold the dataset falls back to the
# NAS rather than failing the job. Note /cache is on the root filesystem, so
# MIN_FREE_GB is what protects / from filling up.
#LELAB_DATASET_CACHE_ROOT=/cache/datasets
#LELAB_DATASET_CACHE_MIN_FREE_GB=50
