# Copy this file to config/site.env and review every value before running scripts.
# This file contains no passwords or tokens.

TIMEZONE=Asia/Singapore

# Management plane
MANAGEMENT_HOST=mgmt01
MANAGEMENT_IP=192.168.100.202
PLATFORM_API_URL=https://192.168.100.202/api
ADMIN_USER=kewei

# QNAP NFS
NAS_IP=192.168.100.184
NAS_EXPORT=/robot_platform
NAS_MOUNT=/mnt/robot_platform
# Dedicated QNAP share "robot_platform"; skeleton dirs (raw/, incoming/, ...)
# live directly at the share root. This pilot keeps the QNAP NFS export on
# "squash all users to guest" (all_squash): every platform account is mapped
# to guest server-side, so skeleton dirs only need to be writable by the QNAP
# guest account. The 2200:2200 setgid convention applies only if the export
# is later switched to honor client UID/GID.
PLATFORM_ROOT=/mnt/robot_platform
NFS_VERSION=4.0

# Cluster naming
SLURM_CLUSTER_NAME=robot-platform
GPU_NODE_NAMES="mgmt01 gpu01 gpu02 gpu03 gpu04 gpu05"
GPU_NODE_IPS="192.168.100.202 192.168.100.215 192.168.100.216 192.168.100.217 192.168.100.206 192.168.100.209"

# Slurm requires the job user and primary group to resolve to the same numeric
# IDs on every worker. These IDs are not used for QNAP ACL management.
DATA_GROUP=robotdata
DATA_GID=2200
INGEST_USER=robot-ingest
COLLECTOR_USER=robot-collector
TRAIN_USER=robot-train
TRAIN_UID=2202

# Local paths
PLATFORM_STATE_ROOT=/var/lib/robot-platform
COLLECTOR_SPOOL_ROOT=/var/spool/robot-data
DATASET_CACHE_ROOT=/cache/datasets
EXPORT_CACHE_ROOT=/cache/exports
RUN_WORK_ROOT=/work/runs
TRAIN_ENV_ROOT=/opt/robot-platform/train-venv
# Branch, tag or commit SHA of LEROBOT_GIT_URL below. A branch is a moving
# target: two nodes installed on different days get different code. Pin a tag or
# SHA for a build you intend to reproduce.
LEROBOT_GIT_REF=dev
# Policy extras installed into the training venv. Add a policy's extra here when
# it needs third-party packages; see lerobot/src/lerobot/policies/<name>/README.md.
LEROBOT_EXTRAS=core_scripts,training,smolvla,pi,vita
# LeRobot v0.6.0 requires Python >= 3.12; Ubuntu 22.04 system python3 is 3.10.
TRAIN_PYTHON_BIN=python3.12
# PyPI index used by the training environment installer (Tsinghua mirror).
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# The lerobot/ submodule's own fork, so a fresh install lands on the policies
# developed in this repository (VITA, ...) rather than on upstream. Keep this in
# sync with the submodule URL in .gitmodules. Behind a git mirror because
# github.com is unreliable from the deployment network (verified 2026-08-12).
# Alternatives: https://ghfast.top/https://github.com/Yingminj/lerobot_dev.git
# or the direct https://github.com/Yingminj/lerobot_dev.git
# Upstream, for a node that should track HuggingFace instead:
# https://gh-proxy.com/https://github.com/huggingface/lerobot.git with REF=v0.6.0
LEROBOT_GIT_URL=https://gh-proxy.com/https://github.com/Yingminj/lerobot_dev.git

# Disk watermarks used by the collector/cache scripts implemented later.
COLLECTOR_MIN_FREE_GB=200
CACHE_MIN_FREE_GB=300

# If Docker is missing, role installers can install the Ubuntu package.
# Set to 0 to require a pre-installed Docker Engine instead.
ALLOW_DOCKER_INSTALL=1
